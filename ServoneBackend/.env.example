# ==========================================
# ServoneBackend Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
BASE_PATH=/api/v1
BACKEND_URL=https://servonekart.onrender.com
PLATFORM_REF_ID=000000000000000000000000

# Database Configuration (Local MongoDB or MongoDB Atlas in Production)
MONGO_URI=mongodb://localhost:27017/servonekart
MONGODB_URI=mongodb://localhost:27017/servonekart

# Client & CORS Origins (Admin Panel & Web Clients)
CLIENT_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SOCKET_IO_CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=https://servonekart.onrender.com,https://ecdadminpanel.vercel.app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=90d
ADMIN_API_KEY=your_admin_api_key_placeholder

# Optional: Seed an initial Super Admin in production if no admin exists in DB
# ADMIN_SEED_EMAIL=admin@servonekart.com
# ADMIN_SEED_PASSWORD=change_me_strong_password

# Payment Gateways
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder_key

# Payment Flow Rules
COD_MAX_AMOUNT=5000
PAYMENT_TIMEOUT_MINUTES=15

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ImageKit (Media CDN & Storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Two-Factor (2Factor.in SMS Gateway)
TWO_FACTOR_API_KEY=your_2factor_api_key
TWO_FACTOR_SENDER_ID=ECDKRT
TWO_FACTOR_TEMPLATE_NAME=ECDKARTOTP

# Firebase Admin SDK (Cloud Messaging & Push Notifications)
# Format: JSON stringified service account credentials
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}'
